# --- InfluxDB 3 target (required for all commands) ---
INFLUXDB3_HOST_URL=http://localhost:8181
INFLUXDB3_AUTH_TOKEN=your-v3-token-here
INFLUXDB3_DATABASE_NAME=GEItemPrices

# --- InfluxDB v2 source (required only for the `migrate` command) ---
V2_INFLUX_URL=http://localhost:8086
V2_INFLUX_TOKEN=your-v2-token-here
V2_INFLUX_ORG=Ge-data-project
V2_INFLUX_BUCKET=GEItemPrices

LOG_LEVEL=INFO
