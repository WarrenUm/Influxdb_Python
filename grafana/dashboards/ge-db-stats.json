    {
      "id": 4,
      "type": "stat",
      "title": "Data freshness (latest snapshot)",
      "description": "Timestamp of the most recent stored row. With the 5-minute catch-up running this should stay within a few minutes of now; a large value means ingestion has stalled. Uses 'Last *' + time unit so Grafana shows the age.",
      "datasource": { "type": "influxdata-flightsql-datasource", "uid": "influxdb-v3-ge" },
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeFromNow",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
