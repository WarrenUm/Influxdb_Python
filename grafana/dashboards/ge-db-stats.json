          "queryText": "SELECT date_bin(INTERVAL '1 hour', time) AS time, COUNT(*) AS \"records\" FROM \"itemPrice\" WHERE time >= $__timeFrom() AND time <= $__timeTo() GROUP BY 1 ORDER BY 1",
          "rawSql": "SELECT date_bin(INTERVAL '1 hour', time) AS time, COUNT(*) AS \"records\" FROM \"itemPrice\" WHERE time >= $__timeFrom() AND time <= $__timeTo() GROUP BY 1 ORDER BY 1"
