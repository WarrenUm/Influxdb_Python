      "title": "Records written per hour",
      "description": "Row count binned into 1-hour buckets over the selected time range. Reflects when snapshots landed in the store (both the 5-minute catch-up and any backfill writes that fall in-range). Bounded by the time picker so it stays fast.",
      "datasource": { "type": "influxdata-flightsql-datasource", "uid": "influxdb-v3-ge" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 11 },
      "fieldConfig": {
        "defaults": {
          "custom": {
