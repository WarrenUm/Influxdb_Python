# Configuration for the Grafana container (docker-compose).
# Copy this file to `.env` in this same "grafana/docker" directory and adjust as
# needed. `.env` is git-ignored so tokens/passwords never land in source control.

# --- Networking ---
# Host port to publish the Grafana UI on -> http://localhost:${GRAFANA_HOST_PORT}
GRAFANA_HOST_PORT=3001

# --- InfluxDB 3 connection (consumed by the provisioned datasource) ---
# Bare host:port of the InfluxDB 3 FlightSQL endpoint AS SEEN FROM INSIDE
# the Grafana container. InfluxDB runs in its own container and publishes this
# port on the host, so Grafana reaches it through the host gateway.
#   - Same host, InfluxDB port published on host (default): host.docker.internal:8181
#   - Pin to this host's LAN address instead:               192.168.1.85:8181
GRAFANA_INFLUXDB3_HOST=host.docker.internal:8181

# The v3 database (bucket) the dashboards query. Must match the pipeline/InfluxDB.
INFLUXDB3_DATABASE_NAME=GEItemPrices

# Auth token for InfluxDB 3. While InfluxDB runs with --without-auth (local/dev),
# any non-empty value is accepted. Set a real token for a networked deployment.
INFLUXDB3_AUTH_TOKEN=local-dev-token

# --- Grafana login ---
# Initial admin credentials. Change the password for anything beyond local dev.
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin

# Plugins installed on startup. The FlightSQL datasource is required for v3 SQL.
GF_INSTALL_PLUGINS=influxdata-flightsql-datasource
