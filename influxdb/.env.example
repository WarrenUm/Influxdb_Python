# Configuration for the InfluxDB 3 Enterprise database container (docker-compose).
# Copy this file to `.env` in this same "influxdb" directory and adjust as
# needed. `.env` is git-ignored so tokens and the license email never land in
# source control.

# --- Networking ---
# Host port to publish the InfluxDB 3 HTTP API + Flight/gRPC endpoint on.
# The app / Grafana connect to http://localhost:${INFLUXDB3_HOST_PORT}
INFLUXDB3_HOST_PORT=8181

# Port INSIDE the container (matches serve --http-bind). Rarely needs changing;
# change the host port above instead.
INFLUXDB3_CONTAINER_PORT=8181

# --- Server identity / storage ---
# Logical node id for this single-node instance.
INFLUXDB3_NODE_ID=ge-node

# --- Database ---
# The database (a.k.a. bucket) the pipeline reads/writes. The init step creates
# it if it does not already exist.
INFLUXDB3_DATABASE_NAME=GEItemPrices

# --- Auth ---
# For local/dev use the server runs with auth DISABLED (--without-auth) and any
# non-empty token is accepted by clients. This token value is only used by the
# init step's CLI calls and is otherwise a placeholder. Set a real token and
# switch the compose command to an authed mode for anything exposed to a network.
INFLUXDB3_AUTH_TOKEN=local-dev-token

# --- Query file limit ---
# InfluxDB 3 limits how many Parquet files a single query may scan (default 432).
# On Core a large backfill created many small files, so this had to be raised to
# a huge value. Enterprise runs the compaction service and merges those files
# automatically, so the cap can sit near the default. IMPORTANT: `0` does NOT
# mean unlimited — it is taken literally (allow 0 files), which makes EVERY query
# fail. There is no "unlimited" sentinel; use a finite integer. Raise this only
# if a query fails with "would scan N Parquet files, exceeding the file limit"
# (e.g. during a fresh backfill before compaction has caught up).
INFLUXDB3_QUERY_FILE_LIMIT=2000

# --- Compaction: max source files per plan ---
# Max source files the compactor pulls into one plan (InfluxDB default 500).
# Raised modestly so the compactor stops logging "skipping level compaction due
# to file limit" on denser windows. IMPORTANT: this does NOT fix the large gen1
# backlog left by a one-shot history backfill — that is a known upstream bug
# (influxdata/influxdb#27301) where backfilled historical data whose timestamps
# are far from wall-clock time is never selected for compaction at all
# (system.compaction_events show plans_ran:[]). Kept modest to keep memory per
# plan low. Runtime knob, NOT persisted in the catalog (unlike --gen1-duration,
# which must never be changed after first start).
INFLUXDB3_COMPACTION_MAX_NUM_FILES_PER_PLAN=2000

# --- InfluxDB 3 Enterprise (At-Home license) ---
# Required by the `influxdb3` service. Copy these into your git-ignored `.env`
# and set a real email; on first start Enterprise sends an activation link there
# and waits until you click it. Do NOT put a real email in this committed
# example file.
INFLUXDB3_LICENSE_EMAIL=you@example.com
# Cluster id required by Enterprise (Core ignores it). Becomes part of the
# storage path — pick one and keep it stable.
INFLUXDB3_CLUSTER_ID=ge-cluster

