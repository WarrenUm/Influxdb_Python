# Configuration for the InfluxDB 3 Core database container (docker-compose).
# Copy this file to `.env` in this same "influxdb" directory and adjust as
# needed. `.env` is git-ignored so tokens never land in source control.

# --- Networking ---
# Host port to publish the InfluxDB 3 HTTP API + Flight/gRPC endpoint on.
# The app / Grafana connect to http://localhost:${INFLUXDB3_HOST_PORT}
INFLUXDB3_HOST_PORT=8181

# Port INSIDE the container (matches the Dockerfile/serve --http-bind). Rarely
# needs changing; change the host port above instead.
INFLUXDB3_CONTAINER_PORT=8181

# --- Server identity / storage ---
# Logical node id for this single-node Core instance.
INFLUXDB3_NODE_ID=ge-node

# --- Database ---
# The database (a.k.a. bucket) the pipeline reads/writes. The init step creates
# it if it does not already exist.
INFLUXDB3_DATABASE_NAME=GEItemPrices

# --- Auth ---
# For local/dev use the server runs with auth DISABLED (--without-auth) and any
# non-empty token is accepted by clients. This token value is only used by the
# init step's CLI calls and is otherwise a placeholder. Set a real token and
# switch the compose command to an authed mode for anything exposed to a network.
INFLUXDB3_AUTH_TOKEN=local-dev-token

# --- Query file limit ---
# InfluxDB 3 Core limits how many Parquet files a single query may scan
# (default 432). Core does not auto-compact, so a large history backfill creates
# many small files and wide/unbounded queries (whole-store COUNT/DISTINCT, the
# Grafana $itemID variable, full-history stat panels) exceed the cap and error
# with "Query would scan N Parquet files, exceeding the file limit".
# Set a HIGH FINITE number to lift the cap. IMPORTANT: `0` does NOT mean
# unlimited on Core — it is taken literally (allow 0 files), which makes EVERY
# query fail. There is no "unlimited" sentinel; use a large integer instead.
# The default below is sized to cover the full ~5-year history.
# Trade-off: wider scans use more memory/CPU and can OOM the process; the
# compaction that would avoid this is an Enterprise feature.
INFLUXDB3_QUERY_FILE_LIMIT=1000000
