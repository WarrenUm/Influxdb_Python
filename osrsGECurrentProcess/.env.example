# Configuration for the osrsGECurrentProcess container (docker-compose).
# Copy this file to `.env` in this same "osrsGECurrentProcess" directory and
# adjust. `.env` is git-ignored so tokens never land in source control.
#
# This container runs ge-pipeline catch-up ingestion every 5 minutes and writes
# to the SAME InfluxDB 3 database the rest of the pipeline uses.

# --- InfluxDB 3 target (all three required) ---
# Base URL of the InfluxDB 3 server this process writes to. In the split live
# deployment the ingestion writes over the LAN to the server host:
#   INFLUXDB3_HOST_URL=http://192.168.1.85:8181
# If you run this container on the SAME host as InfluxDB via compose, put both on
# a shared docker network and use the service name instead, e.g.
#   INFLUXDB3_HOST_URL=http://influxdb3:8181
INFLUXDB3_HOST_URL=http://192.168.1.85:8181

# Auth token. The server runs --without-auth for local/dev, so any non-empty
# value is accepted; set a real token if the server enforces auth.
INFLUXDB3_AUTH_TOKEN=local-dev-token

# Database (bucket) the pipeline reads/writes.
INFLUXDB3_DATABASE_NAME=GEItemPrices

# --- Logging ---
# Daemon log verbosity (DEBUG, INFO, WARNING, ERROR).
LOG_LEVEL=INFO
